# CareNote AI — environment configuration
# Copy to .env and fill in what you have. The pipeline runs with ZERO paid
# keys: the default provider is a local Llama via Ollama.

# Which provider to use by default: ollama | anthropic | openai
CARENOTE_PROVIDER=ollama

# Stronger model the validation chain falls back to when extraction output
# keeps failing schema validation. Unset = skip the fallback stage.
#CARENOTE_FALLBACK_PROVIDER=anthropic
#CARENOTE_FALLBACK_MODEL=claude-opus-5-5

# Optional: append pipeline JSON-lines events to this file (always on stderr).
#CARENOTE_LOG_FILE=logs/pipeline.jsonl

# --- Ollama (default, free, local) ---
# Install from https://ollama.com, then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Anthropic (optional) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- OpenAI (optional) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
